extends SceneTree

func _initialize() -> void:
	var battle := RPGATBBattle.new()
	root.add_child(battle)
	var quick := Node.new()
	var slow := Node.new()
	quick.set_meta("atb_speed", 2.0)
	slow.set_meta("atb_speed", 1.0)
	root.add_child(quick)
	root.add_child(slow)

	var ready_events: Array[Node] = []
	battle.gauge_ready.connect(func(actor: Node) -> void: ready_events.append(actor))
	battle.start_battle([quick, slow])
	assert(battle.running, "Battle starts with participants")
	battle._process(25.0)
	assert(is_equal_approx(battle.get_gauge(quick), 50.0), "Speed metadata scales gauge charge")
	assert(is_equal_approx(battle.get_gauge(slow), 25.0), "Default speed charges at base rate")
	battle._process(25.0)
	assert(battle.is_ready(quick), "Quick actor reaches a full gauge")
	assert(not battle.is_ready(slow), "Slow actor is not ready yet")
	assert(ready_events.size() == 1 and ready_events[0] == quick, "Ready signal fires once")
	battle._process(50.0)
	assert(ready_events.size() == 2 and ready_events[1] == slow, "Second actor reaches ready state")
	assert(battle.get_gauge(quick) == battle.gauge_max, "Ready gauge stays full until command resolution")
	assert(battle.consume_turn(quick), "A ready turn can be consumed")
	assert(not battle.consume_turn(quick), "A turn cannot be consumed twice")
	assert(is_zero_approx(battle.get_gauge(quick)), "Consuming a turn resets its gauge")
	battle.remove_battler(slow)
	assert(battle.battlers.size() == 1, "Removed battler leaves the battle")
	battle.stop_battle()
	assert(not battle.running and battle.battlers.is_empty(), "Stopping clears battle state")
	quick.queue_free()
	slow.queue_free()
	battle.queue_free()
	print("ATB tests passed: charge rates, readiness, turn consumption and cleanup.")
	quit()
